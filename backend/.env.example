# The Shadow Swarm - Overlord C2 Environment Configuration

# Multi-Provider LLM Settings
# Supported Providers: anthropic, openai, ollama, mock
LLM_PROVIDER=mock

# Anthropic API Settings
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1

# Ollama API Settings (For local offline LLMs)
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Swarm Operational Settings
SWARM_VERBOSE=true
SWARM_DELAY_FACTOR=1.0
