# The Shadow Swarm - Active Environment Settings

# Supported Providers: anthropic, openai, ollama, mock
LLM_PROVIDER=openai

# Anthropic API Settings
# To use Claude, change LLM_PROVIDER above to 'anthropic' and paste your API key here:
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Settings / LM Studio Settings
# To run LM Studio (which runs a local OpenAI-compatible server):
# 1. Start your local server in LM Studio on port 1234.
# 2. Keep the settings below as configured.
OPENAI_API_KEY=lm-studio
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_MODEL=qwen3-14b

# Ollama API Settings (Local offline models)
# To use local Ollama, change LLM_PROVIDER above to 'ollama' and ensure Ollama is running locally:
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b

# Swarm Operational Settings
SWARM_VERBOSE=true
SWARM_DELAY_FACTOR=1.0
